NODE_ENV=development
# Valid TCP port range: 1 - 65535.
PORT=3001

# PostgreSQL / Supabase connection string. Server-side only — never expose
# to the frontend or commit a real value.
# Example: postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# Deployment-owner/migration credential. Used ONLY by npm run migrate;
# it must be a different PostgreSQL login from DATABASE_URL. Ordinary API
# startup does not require or use it.
MIGRATION_DATABASE_URL=
# permit_privileged login, used only for the CEO Site Manager grant and
# provisioning functions (DEPLOYMENT.md). Absent: those actions fail closed.
PRIVILEGED_DATABASE_URL=

# Require SSL for database connections. Must be true in production; must
# match what Supabase requires (true) unless connecting to a local
# Postgres instance without SSL.
DB_SSL=true

# Path to a PEM-encoded CA certificate to trust for the database TLS
# connection (e.g. Supabase's CA). Optional; when unset and DB_SSL=true,
# the platform's default trusted CA store is used instead.
DB_CA_CERT_PATH=./certs/supabase-ca.crt

# Connection pool tuning (optional; sensible defaults applied if unset).
# Bounded ranges (values outside these fail startup validation):
#   DB_POOL_MAX:             1 - 100
#   DB_IDLE_TIMEOUT_MS:      0 - 3,600,000  (0 = never auto-disconnect idle clients)
#   DB_CONNECTION_TIMEOUT_MS: 0 - 60,000    (0 = no connect timeout)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Authentication is Permit-owned (permit.users + server-side sessions). No
# Supabase Auth URL, publishable key or service-role key is read; do not
# configure one.

# Storage-scoped S3 credentials from Supabase Storage. Configure all four
# together for the PDF worker/download path; never expose them to the
# frontend. The private bucket must already exist, allow application/pdf,
# and have a sensible file-size limit; the backend verifies this and
# fails closed, but never creates or makes a bucket public.
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_DOCUMENT_BUCKET=issued-permit-documents
# Permit-owned Dropbox App Folder. Configure only on the backend; keep the
# legacy S3 values above for historical reads until offline migration.
PERMIT_STORAGE_MASTER_KEY=
PERMIT_STORAGE_KEY_VERSION=1
# During a key rotation only: the previous key(s), read-only, as
# "version:base64key[,version:base64key]". Remove a version only after
# `npm run storage:rekey` lists it as removable.
PERMIT_STORAGE_PREVIOUS_KEYS=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_OAUTH_ORIGIN=

# IANA time zone used to evaluate permit validity (next-midnight expiry).
# Required - must match the site's actual local timezone.
# Example: Asia/Karachi
SITE_TIMEZONE=

# Comma-separated list of allowed frontend origins for CORS (no wildcard).
# Required in production. In development, defaults to the local Vite dev
# origin (http://localhost:5173) if left unset.
# Example: https://permits.example.com,https://staging-permits.example.com
CORS_ALLOWED_ORIGINS=

# Comma-separated allowlist of the SPECIFIC reverse-proxy addresses/
# networks in front of this backend - controls Express's `trust proxy`,
# which controls what req.ip trusts from X-Forwarded-For. Unset/empty
# (default) = no proxy trusted, correct only when this process is
# reached directly. Behind a real reverse proxy/load balancer in
# production, this MUST list the proxy's real address(es)/network(s) -
# see DEPLOYMENT.md. NEVER a hop count and NEVER a wildcard/"trust
# everything" value (e.g. 0.0.0.0/0) - either would let a client forge
# X-Forwarded-For and choose its own req.ip.
# Accepts: IPv4/IPv6 addresses, CIDR blocks, and the preset names
# loopback / linklocal / uniquelocal.
# Example: 10.0.0.5,10.0.1.0/24
TRUST_PROXY_CIDRS=

# Rate limiting (backend-wide, in-memory - see DEPLOYMENT.md for the
# documented per-instance/horizontal-scaling constraint). Sensible
# defaults apply if unset. Bounded ranges (values outside these fail
# startup validation - see config/env.ts):
#   RATE_LIMIT_WINDOW_MS:     1,000 - 3,600,000  (1 second - 1 hour)
#   RATE_LIMIT_GLOBAL_MAX:    1 - 10,000
#   RATE_LIMIT_MUTATION_MAX:  1 - 1,000
#   RATE_LIMIT_ACCOUNT_MAX:           1 - 200   (own password change)
#   RATE_LIMIT_MANAGER_ACCOUNT_MAX:   1 - 1,000 (manager WRITES: employee
#     create/reset/permissions). No business quota on employee creation -
#     120 clears a 60-employee onboarding session with headroom.
#   RATE_LIMIT_MANAGER_READ_MAX:      1 - 5,000 (manager READS: directory,
#     employee detail, System Site Managers, audit logs). Separate budget
#     so browsing never consumes the provisioning allowance.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=1200
RATE_LIMIT_MUTATION_MAX=30
RATE_LIMIT_ACCOUNT_MAX=10
RATE_LIMIT_MANAGER_ACCOUNT_MAX=120
RATE_LIMIT_MANAGER_READ_MAX=300

# Sign-in protection (A05-P1; SECURITY.md "Sign-in workload and timing").
#   RATE_LIMIT_LOGIN_MAX:          1 - 200  sign-in attempts per client IP per window
#   RATE_LIMIT_LOGIN_ACCOUNT_MAX:  1 - 500  FAILED sign-ins per email per window
#   AUTH_KDF_CONCURRENCY:          1 - 16   password KDFs running at once per process
#     (1 for a 0.5-1 vCPU instance; 2 only with >= 2 vCPU)
#   AUTH_KDF_QUEUE_MAX:            0 - 256  KDFs allowed to wait; beyond that: 429
#   AUTH_KDF_QUEUE_TIMEOUT_MS:     100 - 30,000
#   AUTH_FAILURE_FLOOR_MAX_MS:     0 - 5,000  cap on the failed-sign-in timer floor
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_MAX=20
AUTH_KDF_CONCURRENCY=1
AUTH_KDF_QUEUE_MAX=8
AUTH_KDF_QUEUE_TIMEOUT_MS=2000
AUTH_FAILURE_FLOOR_MAX_MS=1000
