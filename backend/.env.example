NODE_ENV=development
# Valid TCP port range: 1 - 65535.
PORT=3001

# PostgreSQL / Supabase connection string. Server-side only — never expose
# to the frontend or commit a real value.
# Example: postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# Require SSL for database connections. Must be true in production; must
# match what Supabase requires (true) unless connecting to a local
# Postgres instance without SSL.
DB_SSL=true

# Path to a PEM-encoded CA certificate to trust for the database TLS
# connection (e.g. Supabase's CA). Optional; when unset and DB_SSL=true,
# the platform's default trusted CA store is used instead.
DB_CA_CERT_PATH=./certs/supabase-ca.crt

# Connection pool tuning (optional; sensible defaults applied if unset).
# Bounded ranges (values outside these fail startup validation):
#   DB_POOL_MAX:             1 - 100
#   DB_IDLE_TIMEOUT_MS:      0 - 3,600,000  (0 = never auto-disconnect idle clients)
#   DB_CONNECTION_TIMEOUT_MS: 0 - 60,000    (0 = no connect timeout)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Supabase project URL and publishable (anon) key, used server-side only to
# verify user access tokens (auth.getClaims). This is the publishable key,
# not a secret/service-role key — never put a service-role key here.
# Example: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# IANA time zone used to evaluate permit validity (next-midnight expiry).
# Required - must match the site's actual local timezone.
# Example: Asia/Karachi
SITE_TIMEZONE=

# Comma-separated list of allowed frontend origins for CORS (no wildcard).
# Required in production. In development, defaults to the local Vite dev
# origin (http://localhost:5173) if left unset.
# Example: https://permits.example.com,https://staging-permits.example.com
CORS_ALLOWED_ORIGINS=

# Comma-separated allowlist of the SPECIFIC reverse-proxy addresses/
# networks in front of this backend - controls Express's `trust proxy`,
# which controls what req.ip trusts from X-Forwarded-For. Unset/empty
# (default) = no proxy trusted, correct only when this process is
# reached directly. Behind a real reverse proxy/load balancer in
# production, this MUST list the proxy's real address(es)/network(s) -
# see DEPLOYMENT.md. NEVER a hop count and NEVER a wildcard/"trust
# everything" value (e.g. 0.0.0.0/0) - either would let a client forge
# X-Forwarded-For and choose its own req.ip.
# Accepts: IPv4/IPv6 addresses, CIDR blocks, and the preset names
# loopback / linklocal / uniquelocal.
# Example: 10.0.0.5,10.0.1.0/24
TRUST_PROXY_CIDRS=

# Rate limiting (backend-wide, in-memory - see DEPLOYMENT.md for the
# documented per-instance/horizontal-scaling constraint). Sensible
# defaults apply if unset. Bounded ranges (values outside these fail
# startup validation - see config/env.ts):
#   RATE_LIMIT_WINDOW_MS:     1,000 - 3,600,000  (1 second - 1 hour)
#   RATE_LIMIT_GLOBAL_MAX:    1 - 10,000
#   RATE_LIMIT_MUTATION_MAX:  1 - 1,000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_MUTATION_MAX=30
