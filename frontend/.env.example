# =====================================================================
# Frontend environment - PUBLIC, BROWSER-SAFE VALUES ONLY
# =====================================================================
#
# Everything a Vite build reads through `VITE_*` is COMPILED INTO THE
# JAVASCRIPT BUNDLE and is therefore readable by anyone who opens the
# application. Only values that are safe to publish may appear here.
#
# NEVER put any of these in this file, or in any VITE_ variable:
#   SUPABASE_SERVICE_ROLE_KEY   DATABASE_URL
#   MIGRATION_DATABASE_URL      PRIVILEGED_DATABASE_URL
#   S3_SECRET_ACCESS_KEY        any database password
#   any operator credential
#
# They are server-only. The backend holds them; the browser never does.
# `src/test/security.test.ts` fails the build's test run if any of them
# is ever referenced from frontend source.
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored
# and must never be committed.

# Base URL of the backend API, WITHOUT the /api/v1 path - the API client
# adds that itself. Leave empty when the frontend is served from the same
# origin as the API (a reverse proxy in production).
VITE_API_BASE_URL=http://localhost:3001

# Supabase project URL and PUBLISHABLE (anon) key. Both are designed to be
# public and are safe in a browser bundle. The publishable key grants no
# data access on its own: the browser client authenticates only, and every
# table in this system is default-deny with no policy for the browser
# roles, so all application data is read through the backend API.
# Example URL: https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
