# Build-time configuration for the Playwright visual-QA build ONLY.
#
# These values are deliberately fake. Building the e2e bundle with them
# means the browser under test cannot reach the real Supabase project or
# the real API even if a route stub were missed - the app simply points
# at a host that does not exist. No real credential is present here, and
# this file is committed on purpose so the guarantee is reviewable.
VITE_API_BASE_URL=http://localhost:4173
